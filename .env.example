# ==============================================================================
# NetAtlas Environment Configuration
# Copy this file to .env before starting Docker Compose:
#   Copy-Item .env.example .env
# ==============================================================================

# --- PostgreSQL / Netdisco Database -------------------------------------------
NETDISCO_CURRENT_PG_VERSION=18
NETDISCO_DB_NAME=netdisco
NETDISCO_DB_USER=netdisco
NETDISCO_DB_PASS=netatlas_dev_password
NETDISCO_DB_HOST=netdisco-postgresql
NETDISCO_DB_PORT=5432

# --- Netdisco Discovery Engine ------------------------------------------------
NETDISCO_DOMAIN=discover
NETDISCO_RO_COMMUNITY=public
DEPLOY_ADMIN_USER=YES

# --- NetAtlas API -------------------------------------------------------------
# Set MOCK_MODE=true to develop & test UI without physical switches/Netdisco DB.
# Set MOCK_MODE=false when connected to a live site and Netdisco PostgreSQL DB.
MOCK_MODE=true
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost
STATUS_POLL_ENABLED=true
STATUS_POLL_INTERVAL_SECONDS=30

# --- NetAtlas UI & Reverse Proxy ----------------------------------------------
UI_PORT=5173
NETDISCO_WEB_PORT=5000
NGINX_PORT=80
